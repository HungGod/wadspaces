[Desktop Entry]
# Put in /usr/share/applications at start only when the wadspace has
# WadBrowser (its template writes /etc/wadspaces/wadbrowser.conf), and opens
# as that file says: full, or focus (no address bar: the Extensions' choice).
Type=Application
Name=WadBrowser
GenericName=Web Browser
Comment=Browse the web
Exec=/usr/local/bin/wadbrowser --default %U
Icon=wadbrowser
Terminal=false
StartupNotify=true
StartupWMClass=wadbrowser
Categories=Network;WebBrowser;
Keywords=web;browser;internet;
