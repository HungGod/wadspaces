    {
      "id": "wadbrowser",
      "name": "WadBrowser",
      "summary": "The browser in every wadspace, and every web app's window",
      "description": "Tabs and an address bar, or Focus: tabs with no address bar, so pages only arrive by links. Each web app you add opens in its own WadBrowser window with its own name and icon, and web apps can share one sign-in (a cookie profile) or keep their own.",
      "category": "Internet",
      "icon": "/brand/wadbrowser-icon-dark.svg",
      "screenshots": [
        {
          "src": "/apps/wadbrowser/home-dark.png",
          "caption": "Home page, dark theme"
        },
        {
          "src": "/apps/wadbrowser/home-light.png",
          "caption": "Home page, light theme"
        },
        {
          "src": "/apps/wadbrowser/focus-dark.png",
          "caption": "Focus: tabs, no address bar"
        }
      ],
      "install": {
        "kind": "builtin",
        "desktop": [
          "wadbrowser.desktop"
        ],
        "source": "Comes with the base image"
      },
      "example": null,
      "license": "Part of WadSpaces",
      "homepage": null,
      "options": "wadbrowser",
      "opensFolders": false,
      "secret": null
    },
    {
      "id": "vscode",
      "name": "VS Code",
      "summary": "Code editor with extensions",
      "description": "Microsoft's code editor. Its Extensions pick its extensions, which are installed into the image so they're there on first start. A key keeps its settings and accounts, and AI extensions like Claude Code and Codex keep keys of their own.",
      "category": "Development",
      "icon": "/apps/vscode/icon.png",
      "screenshots": [
        {
          "src": "/apps/vscode/shot-1.png",
          "caption": "Editing TypeScript"
        }
      ],
      "install": {
        "kind": "feature",
        "feature": "vscode",
        "desktop": [
          "wadspaces-vscode.desktop"
        ],
        "source": "Microsoft's .deb"
      },
      "example": "https://github.com/linuxserver/docker-vscode",
      "license": "Proprietary (https://code.visualstudio.com/license)",
      "homepage": "https://code.visualstudio.com",
      "options": "vscode",
      "opensFolders": true,
      "secret": {
        "kind": "vscode",
        "id": "VSCode"
      }
    },
