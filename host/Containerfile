# WadSpaces host OS: Fedora bootc -> greetd -> sway -> WadSpaces Client (Tauri),
# plus wadd (the machine daemon: workspaces, projects, the account link;
# apps/wadd, Rust). Two apps run on the machine itself, opened and closed by
# wadd like wadspaces: a terminal (foot) and WadBrowser (apps/wadbrowser); see
# usr/lib/wadspaces/workspaces.d/{terminal,browser}.toml. Build from the repo root:
#   host/build.sh image        (or: podman build -f host/Containerfile -t localhost/wadspaces-host .)
FROM quay.io/fedora/fedora-bootc:43

RUN dnf -y install --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
      sway greetd podman \
      webkit2gtk4.1 librsvg2 shared-mime-info \
      python3 \
      mesa-dri-drivers libva-utils \
      adwaita-cursor-theme google-noto-sans-fonts google-noto-emoji-fonts liberation-fonts rsms-inter-vf-fonts \
      dbus-daemon dbus-tools wlr-randr NetworkManager-wifi NetworkManager-tui curl \
      gtk4 gtk4-layer-shell \
      git-core \
      foot \
    && dnf clean all

# Sound: PipeWire in the kiosk session (socket-activated user units). Native
# wadspaces play through its PulseAudio socket (wad-core's quadlet sets
# PULSE_SERVER), and the HUD's volume slider is wpctl (wireplumber).
RUN dnf -y install --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
      pipewire pipewire-pulseaudio pipewire-alsa wireplumber alsa-ucm alsa-sof-firmware \
    && dnf clean all \
    && systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service

# Bluetooth: BlueZ, which wadd drives over D-Bus (pairing through its own
# agent, answered in the HUD). Headphones play through PipeWire like any
# sound; a Bluetooth gamepad is handed to wadspaces like a USB one.
RUN dnf -y install --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
      bluez \
    && dnf clean all

# WadBrowser's media: GStreamer's common codecs (WebKitGTK plays through it).
RUN dnf -y install --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
      gstreamer1-plugins-good gstreamer1-plugins-bad-free gstreamer1-plugin-libav \
    && dnf clean all

# The initramfs again, with the Surface's drivers in it, loaded in order in the
# first seconds of boot: without them the stock kernel's controller hub fails
# and graphics (so the backlight) and sound stall for minutes or never come
# (usr/lib/modprobe.d/wadspaces-surface.conf says why). Its own layer, so it
# only reruns when those two files change.
COPY host/usr/lib/modprobe.d/wadspaces-surface.conf /usr/lib/modprobe.d/
COPY host/usr/lib/dracut/dracut.conf.d/60-wadspaces-surface.conf /usr/lib/dracut/dracut.conf.d/
RUN kver="$(ls /usr/lib/modules)" \
    && dracut --force --no-hostonly --kver "${kver}" "/usr/lib/modules/${kver}/initramfs.img" \
    && chmod 644 "/usr/lib/modules/${kver}/initramfs.img" \
    && lsinitrd "/usr/lib/modules/${kver}/initramfs.img" > /tmp/initrd.txt \
    && for m in pinctrl-sunrisepoint surface_aggregator.ko i915.ko snd-hda-intel snd-hda-codec-alc269 kbl_dmc; do \
         grep -q "${m}" /tmp/initrd.txt || { echo "initramfs lacks ${m}" >&2; exit 1; }; \
       done \
    && rm /tmp/initrd.txt

COPY host/etc/ /etc/
COPY host/usr/ /usr/
# The WadSpaces Client (apps/client, GTK4), built by host/build.sh. It's the
# shell: wadd keeps its window (app_id "client") on screen. With it, its
# GitHub sign-in window (apps/signin) and the account's Firebase project.
COPY --chmod=755 .build/client/client /usr/bin/client
COPY --chmod=755 .build/client/client-signin /usr/libexec/wadspaces/client-signin
COPY --chmod=644 .build/client/firebase.toml /usr/lib/wadspaces/firebase.toml
# wadd (apps/wadd), built by host/build.sh.
COPY --chmod=755 .build/wadd/wadd /usr/bin/wadd
# The HUD (apps/hud, Rust + GTK4 layer-shell), built by host/build.sh.
COPY --chmod=755 .build/hud/hud /usr/libexec/wadspaces/hud
# WadBrowser, the machine's own browser app (wadd runs it), built by host/build.sh.
COPY --chmod=755 .build/wadbrowser/wadbrowser /usr/bin/wadbrowser
# WadSpaces' own pictures (apps' icons, the brand): wadd draws wadspaces'
# desktop icons from them for the HUD's switcher (GET /v1/desktop-icon).
COPY .build/assets/ /usr/share/wadspaces/assets/
# Staged by host/build.sh from host/secrets/: the admin password hash, which
# wadspaces-admin-password.service applies. (No podman secrets are baked in:
# a machine gets its GitHub token by signing in, or from the account.)
COPY .build/secrets/ /usr/lib/wadspaces/secrets/
COPY .build/ssh/ /usr/share/wadspaces/ssh/
# What's WadSpaces' own here (host/etc, host/usr, staged by host/build.sh).
COPY .build/ours.list /usr/lib/wadspaces/ours.list

RUN /usr/bin/client --version && \
    /usr/bin/wadbrowser --version && \
    foot --check-config && \
    find /usr/lib/wadspaces/secrets -type d -exec chmod 700 {} + && \
    find /usr/lib/wadspaces/secrets -type f -exec chmod 600 {} + && \
    chmod 644 /usr/share/wadspaces/ssh/* && \
    for b in dbus-run-session sway curl nmcli skopeo bootc wpctl foot bluetoothctl; do \
      command -v "$b" > /dev/null || { echo "missing $b" >&2; exit 1; }; \
    done && \
    ls /usr/lib/firmware/mrvl/pcie8897_uapsta.bin* /usr/lib64/libgtk4-layer-shell.so.0 > /dev/null && \
    /usr/bin/wadd version && \
    systemctl enable greetd.service podman.socket wadd.socket wadd.service bluetooth.service \
      wadspaces-admin-password.service wadspaces-import.service && \
    systemctl mask bootc-fetch-apply-updates.timer bootc-fetch-apply-updates.service && \
    systemctl set-default graphical.target && \
    systemctl mask getty@tty1.service && \
    rm -rf /var/log/dnf5.log* /var/lib/dnf /var/cache/libdnf5 /run/dnf

# WadSpaces' own files go in a chunk of their own when host/build.sh
# rechunks the image (rpm-ostree's user.component): an update that changes
# them copies that chunk, not the initramfs and the rest no package owns.
RUN python3 - <<'EOF'
import os
ours = [l.strip() for l in open("/usr/lib/wadspaces/ours.list") if l.strip()]
ours += ["/usr/bin/client", "/usr/bin/wadd", "/usr/bin/wadbrowser"]
for top in ["/usr/libexec/wadspaces", "/usr/share/wadspaces", "/usr/lib/wadspaces"]:
    ours += [os.path.join(d, f) for d, _, fs in os.walk(top) for f in fs]
for p in set(ours):
    if os.path.isfile(p) and not os.path.islink(p):
        os.setxattr(p, "user.component", b"wadspaces-apps")
EOF

RUN bootc container lint
