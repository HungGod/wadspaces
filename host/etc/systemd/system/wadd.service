[Unit]
Description=WadSpaces machine daemon (wadd)
# Its API is wadd.socket (/run/wadd/wadd.sock): systemd holds it, so Wad
# Creator and the HUD can connect while wadd (re)starts.
Requires=wadd.socket
After=wadd.socket network-online.target podman.socket
Wants=network-online.target podman.socket

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/wadd serve
Restart=always
RestartSec=2
TimeoutStopSec=10
StateDirectory=wadspaces
# Root: rootful podman, systemd for the workspace units, /dev/input and
# /dev/uinput for the keys. Everything else is locked down.
ProtectSystem=strict
# read-only, not "yes": wadd connects to sway's IPC socket in the kiosk
# session's /run/user/1000, which appears after wadd has started.
ProtectHome=read-only
# /run/containers/systemd: the workspaces' units, written at every start
# (tmpfiles.d makes it). wadspaces-projects: project folders (git runs as
# uid 1000 there). Podman's volumes: a launch adopts a project an older
# image cloned into a workspace's /config volume.
ReadWritePaths=/var/lib/wadspaces /run/containers/systemd
ReadWritePaths=-/var/lib/wadspaces-projects -/var/lib/wadspaces-signins -/var/lib/containers/storage/volumes
# The Cloudflare tunnel's token, when it's replaced (Secrets → Cloud Tunnel).
ReadWritePaths=-/etc/cloudflared
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
