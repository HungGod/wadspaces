# Generated by `wadd gen-quadlets` from workspaces.yaml. Do not edit.
[Unit]
Description=WadSpaces workspace: Writing
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/wadspaces-writing:latest
ContainerName=wad-writing
Label=wadspaces.id=writing
PublishPort=127.0.0.1:3101:3000
Environment=PUID=1000
Volume=/var/lib/wadspaces/copies/p1:/run/wadspaces-copies/p1:ro,z
Volume=/var/home/wad/Thesis:/config/Desktop/Thesis:rw
Volume=/var/lib/wadspaces/extra/writing:/run/wadspaces-extra:ro,z
SecurityLabelDisable=true
Pull=missing

[Service]
Restart=no
TimeoutStartSec=900

# No [Install] section: wadd starts this unit on the first switch.
