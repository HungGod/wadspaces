# Generated by `wadd gen-quadlets` from workspaces.yaml. Do not edit.
[Unit]
Description=WadSpaces workspace: Cosmic Writing
Wants=network-online.target
After=network-online.target
BindsTo=wad-writing-display.service
After=wad-writing-display.service

[Container]
Image=localhost/wadspaces-template-writing:latest
ContainerName=wad-writing
Label=wadspaces.id=writing
Environment=GIT_USER_NAME=x
Environment=PGID=1000
Environment=PUID=1000
Environment=TZ=Pacific/Fiji
Secret=github_token
Volume=/var/lib/wadspaces/copies/p1:/run/wadspaces-copies/p1:ro,z
Volume=/var/lib/wadspaces/extra/writing:/run/wadspaces-extra:ro,z
Volume=wad-writing-display.volume:/run/wadspaces-display:z
Environment=PULSE_SERVER=unix:/run/wadspaces-display/pulse/native
AddDevice=/dev/dri
ShmSize=1g
Pull=missing

[Service]
Restart=no
TimeoutStartSec=900

# No [Install] section: wadd starts this unit on the first switch.
