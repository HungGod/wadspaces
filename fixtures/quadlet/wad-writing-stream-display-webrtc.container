# Generated by wadd: the stream a wadspace draws on while it's streamed. Do not edit.
[Unit]
Description=WadSpaces stream: Cosmic Writing
StopWhenUnneeded=yes

[Container]
Image=localhost/wadspaces-stream:trixie
ContainerName=wad-writing-display
Label=wadspaces.id=writing
Label=wadspaces.role=display
Label=wadspaces.stream=0123456789abcdef0123456789abcdef
Environment=CUSTOM_USER=wad-abcdef
Environment=PGID=1000
Environment=PUID=1000
Environment=TZ=Pacific/Fiji
Environment=SELKIES_MODE=websockets
Environment="TITLE=Cosmic Writing"
Environment=SELKIES_ENABLE_DUAL_MODE=true
Environment=SELKIES_WEBRTC_UDP_MUX_PORT=48200
Environment=SELKIES_WEBRTC_TCP_MUX_PORT=48200
Environment=SELKIES_STUN_HOST=stun.cloudflare.com
Environment=SELKIES_STUN_PORT=3478
Environment=SELKIES_ENABLE_CLOUDFLARE_TURN=true
Environment=SELKIES_CLOUDFLARE_TURN_TOKEN_ID=turn-id
Secret=wad_stream_writing,type=env,target=PASSWORD
Secret=wad_turn_api_token,type=env,target=SELKIES_CLOUDFLARE_TURN_API_TOKEN
Volume=wad-writing-display.volume:/run/wadspaces-display:z
PublishPort=127.0.0.1:48100:3000
PublishPort=48200:48200/udp
PublishPort=48200:48200/tcp
AddDevice=/dev/dri
ShmSize=1g
Pull=never

[Service]
Restart=no
TimeoutStartSec=900
